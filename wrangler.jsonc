{
  "name": "jotas-barber",
  "compatibility_date": "2026-11-08",
  "main": "./src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbxZ0tltUgZYa90zG3wWo4k6bRAFkdHSkuyQrI0gIorb33IrRoz8NqlKJbgtOQukV76A/exec"
  },
  "ratelimits": [
    {
      "name": "AUTH_IP_LIMIT",
      "namespace_id": "44001",
      "simple": { "limit": 15, "period": 60 }
    },
    {
      "name": "AUTH_ACCOUNT_LIMIT",
      "namespace_id": "44002",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "keep_vars": true,
  "previews": {
    "vars": {
      "BOOKING_ENABLED": "true",
      "APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbwDfdai3RYX_MsHalp7Hyqkd8uYG4NJBOoJnekk90zHo6q_Q0w2KhxsV_WrNvyH3WNr/exec"
    },
    "ratelimits": [
      {
        "name": "AUTH_IP_LIMIT",
        "namespace_id": "44101",
        "simple": { "limit": 15, "period": 60 }
      },
      {
        "name": "AUTH_ACCOUNT_LIMIT",
        "namespace_id": "44102",
        "simple": { "limit": 5, "period": 60 }
      }
    ]
  }
}
